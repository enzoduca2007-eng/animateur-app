NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clé service_role (Project Settings > API) — JAMAIS exposée au client,
# utilisée uniquement côté serveur (route /api/etablissements) pour créer
# de nouveaux établissements et leur premier compte directeur.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Zone scolaire (A, B ou C) utilisée pour calculer automatiquement les
# dates de vacances : https://www.education.gouv.fr/calendrier-scolaire
NEXT_PUBLIC_ZONE_SCOLAIRE=A

# Clé API Gemini (gratuite) pour l'analyse des photos de goûters :
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
